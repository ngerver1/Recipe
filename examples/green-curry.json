  "title": "Green chicken curry",
  "source": {
    "url": "https://example.com/green-curry",
    "site": "Example Kitchen",
    "author": "A. Cook"
  },
  "servings": 4,
  "times": { "prepMinutes": 15, "cookMinutes": 25, "totalMinutes": 40 },
  "equipment": ["Saucepan with lid", "Wok or large frying pan"],
  "notes": "Converted from US cups, tablespoons and pounds.",
  "ingredients": [
    { "id": "rice", "name": "jasmine rice", "quantity": 370, "unit": "g", "original": "2 cups", "group": "Rice" },
    { "id": "water", "name": "water", "quantity": 560, "unit": "ml", "original": "2 1/3 cups", "group": "Rice" },
    { "id": "oil", "name": "vegetable oil", "quantity": 15, "unit": "ml", "original": "1 tbsp", "group": "Curry" },
    { "id": "paste", "name": "green curry paste", "quantity": 60, "unit": "g", "original": "1/4 cup", "group": "Curry" },
    { "id": "coconut", "name": "coconut milk", "quantity": 400, "unit": "ml", "original": "1 can (13.5 oz)", "group": "Curry" },
    { "id": "chicken", "name": "chicken thigh fillets", "quantity": 450, "unit": "g", "original": "1 lb", "note": "cut into bite-size pieces", "group": "Curry" },
    { "id": "fish-sauce", "name": "fish sauce", "quantity": 30, "unit": "ml", "original": "2 tbsp", "group": "Curry" },
    { "id": "basil", "name": "Thai basil leaves", "quantity": null, "unit": null, "note": "a handful", "group": "Curry" }
  ],
  "steps": [
    {
      "id": "s1",
      "section": "Rice",
      "title": "Start the rice",
      "text": "Rinse 370 g jasmine rice until the water runs clear. Bring it to the boil with 560 ml water, then cover and turn the heat to low.",
      "uses": [
        { "ingredient": "rice", "quantity": 370, "unit": "g" },
        { "ingredient": "water", "quantity": 560, "unit": "ml" }
      ],
      "timer": { "seconds": 900, "label": "Rice", "background": true },
      "tip": "Keep the lid on the whole time."
    },
    {
      "id": "s2",
      "section": "Curry",
      "title": "Fry the paste",
      "text": "Heat 15 ml oil in the wok over medium heat. Add 60 g curry paste and stir.",
      "uses": [
        { "ingredient": "oil", "quantity": 15, "unit": "ml" },
        { "ingredient": "paste", "quantity": 60, "unit": "g" }
      ],
      "cue": "Fragrant and just starting to darken, about 1 minute."
    },
    {
      "id": "s3",
      "section": "Curry",
      "title": "Simmer the chicken",
      "text": "Stir in 400 ml coconut milk, add 450 g chicken and simmer gently, stirring now and then.",
      "uses": [
        { "ingredient": "coconut", "quantity": 400, "unit": "ml" },
        { "ingredient": "chicken", "quantity": 450, "unit": "g" }
      ],
      "timer": { "seconds": 720, "maxSeconds": 900, "label": "Curry" },
      "cue": "Chicken cooked through, with no pink in the middle."
    },
    {
      "id": "s4",
      "section": "Curry",
      "title": "Season and serve",
      "text": "Stir in 30 ml fish sauce and a handful of Thai basil. Serve over the rice.",
      "uses": [
        { "ingredient": "fish-sauce", "quantity": 30, "unit": "ml" },
        { "ingredient": "basil", "quantity": null, "unit": null }
      ]
    }
  ]
}
