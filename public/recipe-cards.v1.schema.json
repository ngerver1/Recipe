{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngerver1.github.io/Recipe/recipe-cards.v1.schema.json",
  "title": "Recipe Cards, format version 1",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "recipe-cards"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "url": {
          "description": "Link to the original recipe.",
          "type": "string"
        },
        "site": {
          "description": "Name of the site or book, e.g. \"Serious Eats\".",
          "type": "string"
        },
        "author": {
          "type": "string"
        }
      },
      "description": "Where the recipe came from."
    },
    "servings": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "yield": {
      "description": "Text, e.g. \"1 loaf\".",
      "type": "string"
    },
    "times": {
      "type": "object",
      "properties": {
        "prepMinutes": {
          "type": "number",
          "minimum": 0
        },
        "cookMinutes": {
          "type": "number",
          "minimum": 0
        },
        "totalMinutes": {
          "type": "number",
          "minimum": 0
        }
      },
      "description": "Times in minutes."
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "ingredients": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Unique within the recipe, kebab-case, e.g. \"fish-sauce\". Steps refer to it in `uses`."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "What to show, e.g. \"fish sauce\"."
          },
          "quantity": {
            "description": "Total amount, already metric. Null when there is no amount (\"to taste\", \"a handful\").",
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "description": "e.g. \"g\", \"ml\", \"tsp\". Null for plain counts like 2 eggs.",
            "type": [
              "string",
              "null"
            ]
          },
          "original": {
            "description": "The source's wording before conversion, e.g. \"2 tbsp\".",
            "type": "string"
          },
          "note": {
            "description": "Preparation or extra detail, e.g. \"finely chopped\".",
            "type": "string"
          },
          "group": {
            "description": "Heading to list it under, e.g. \"Sauce\".",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "description": "One ingredient with its total amount."
      }
    },
    "steps": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Unique within the recipe, e.g. \"s1\"."
          },
          "section": {
            "description": "Heading for a group of steps, e.g. \"Curry\".",
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "2 to 5 words."
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "What to do, with quantities written inline."
          },
          "uses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ingredient": {
                  "type": "string",
                  "minLength": 1,
                  "description": "An ingredient id."
                },
                "quantity": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "unit": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "ingredient"
              ],
              "description": "What a step needs. The quantity can be part of the ingredient total."
            }
          },
          "timer": {
            "type": "object",
            "properties": {
              "seconds": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "description": "Whole number above 0. For a range, the lower end."
              },
              "maxSeconds": {
                "description": "The upper end of a range.",
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "description": "Short name shown in the timer tray, e.g. \"Rice\"."
              },
              "background": {
                "description": "True when the cook can carry on with the next steps while it runs.",
                "type": "boolean"
              }
            },
            "required": [
              "seconds",
              "label"
            ],
            "description": "A timer the cook can start from this step."
          },
          "cue": {
            "description": "How to tell it's done.",
            "type": "string"
          },
          "tip": {
            "description": "A short helpful note.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "text"
        ],
        "description": "One card in cook mode."
      }
    }
  },
  "required": [
    "format",
    "version",
    "title",
    "steps"
  ],
  "description": "A recipe converted into step cards for the Recipe Cards cook-mode app."
}
